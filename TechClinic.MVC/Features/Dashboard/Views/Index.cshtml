@model TechClinic.MVC.Features.Dashboard.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small mb-1">Open Work Orders</div>
                <div class="fs-2 fw-bold text-warning">@Model.TotalOpenWorkOrders</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small mb-1">Completed Work Orders</div>
                <div class="fs-2 fw-bold text-success">@Model.TotalCompletedWorkOrders</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small mb-1">Waiting Parts</div>
                <div class="fs-2 fw-bold text-danger">@Model.WaitingPartsCount</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small mb-1">Total Revenue (Paid)</div>
                <div class="fs-2 fw-bold text-primary">@Model.RevenueSummary.ToString("N2")</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="fw-semibold">Work Orders</div>
                    <div class="text-muted small">Manage repair orders</div>
                </div>
                <a asp-controller="WorkOrder" asp-action="Index" class="btn btn-outline-primary btn-sm">View All</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="fw-semibold">Technicians</div>
                    <div class="text-muted small">Manage your team</div>
                </div>
                <a asp-controller="Technician" asp-action="Index" class="btn btn-outline-primary btn-sm">View All</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="fw-semibold">Spare Parts</div>
                    <div class="text-muted small">Monitor inventory</div>
                </div>
                <a asp-controller="SparePart" asp-action="Index" class="btn btn-outline-primary btn-sm">View All</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="fw-semibold">Invoices</div>
                    <div class="text-muted small">Track payments</div>
                </div>
                <a asp-controller="Invoice" asp-action="Index" class="btn btn-outline-primary btn-sm">View All</a>
            </div>
        </div>
    </div>
</div>
