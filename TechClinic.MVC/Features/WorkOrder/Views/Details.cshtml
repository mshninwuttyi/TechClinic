@model TechClinic.MVC.Features.WorkOrder.WorkOrderDetailsViewModel
@{
    ViewData["Title"] = "Work Order Details";
}

<div class="row g-3">
    <!-- Work Order Info -->
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                <div>
                    <h6 class="mb-0 fw-semibold">@Model.WorkOrderCode</h6>
                    @{
                        var badgeClass = Model.Status switch
                        {
                            "Open"         => "bg-warning text-dark",
                            "InProgress"   => "bg-primary",
                            "WaitingParts" => "bg-danger",
                            "Completed"    => "bg-success",
                            "Cancelled"    => "bg-secondary",
                            _              => "bg-light text-dark"
                        };
                    }
                    <span class="badge @badgeClass mt-1">@Model.Status</span>
                </div>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">Edit</a>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="text-muted small">Device Type</div>
                        <div>@(Model.DeviceType ?? "-")</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small">Brand</div>
                        <div>@(Model.Brand ?? "-")</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small">Device Model</div>
                        <div>@(Model.DeviceModel ?? "-")</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small">Serial Number</div>
                        <div>@(Model.SerialNumber ?? "-")</div>
                    </div>
                    <div class="col-12">
                        <div class="text-muted small">Problem Description</div>
                        <div>@(Model.ProblemDescription ?? "-")</div>
                    </div>
                    <div class="col-sm-4">
                        <div class="text-muted small">Intake Date</div>
                        <div>@Model.IntakeDate.ToString("dd MMM yyyy")</div>
                    </div>
                    <div class="col-sm-4">
                        <div class="text-muted small">Est. Return Date</div>
                        <div>@(Model.EstimatedReturnDate.HasValue ? Model.EstimatedReturnDate.Value.ToString("dd MMM yyyy") : "-")</div>
                    </div>
                    <div class="col-sm-4">
                        <div class="text-muted small">Est. Cost</div>
                        <div>@(Model.EstimatedCost.HasValue ? Model.EstimatedCost.Value.ToString("N2") : "-")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Side panel -->
    <div class="col-md-4">
        <!-- Assignment -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-semibold">Technician Assignment</h6>
            </div>
            <div class="card-body">
                @if (Model.HasAssignment)
                {
                    <div class="text-muted small">Assigned To</div>
                    <div class="fw-semibold">@Model.AssignedTechnicianName</div>
                    <div class="text-muted small mt-1">@Model.AssignedDate?.ToString("dd MMM yyyy HH:mm")</div>
                    <a asp-controller="Assignment" asp-action="Reassign" asp-route-workOrderId="@Model.Id"
                       class="btn btn-outline-warning btn-sm mt-3 w-100">Reassign</a>
                }
                else
                {
                    <p class="text-muted small mb-3">Not yet assigned.</p>
                    <a asp-controller="Assignment" asp-action="Assign" asp-route-workOrderId="@Model.Id"
                       class="btn btn-outline-primary btn-sm w-100">Assign Technician</a>
                }
            </div>
        </div>

        <!-- Update Status -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-semibold">Update Status</h6>
            </div>
            <div class="card-body">
                <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <select name="status" class="form-select form-select-sm mb-2">
                        @foreach (var s in Model.StatusOptions)
                        {
                            <option value="@s.Value" selected="@s.Selected">@s.Text</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-primary btn-sm w-100">Update</button>
                </form>
            </div>
        </div>

        <!-- Invoice -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-semibold">Invoice</h6>
            </div>
            <div class="card-body">
                <a asp-controller="Invoice" asp-action="Generate" asp-route-workOrderId="@Model.Id"
                   class="btn btn-outline-success btn-sm w-100 mb-2">Generate Invoice</a>
                <a asp-controller="Invoice" asp-action="Index"
                   class="btn btn-outline-secondary btn-sm w-100">View All Invoices</a>
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">&larr; Back to List</a>
</div>
