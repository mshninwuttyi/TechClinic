@model TechClinic.MVC.Features.WorkOrder.SaveWorkOrderViewModel
@{
    ViewData["Title"] = Model.IsEdit ? "Edit Work Order" : "Create Work Order";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-semibold">@ViewData["Title"]</h6>
            </div>
            <div class="card-body">
                <form asp-action="@(Model.IsEdit ? "Edit" : "Create")" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="Id" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="DeviceType" class="form-label fw-semibold"></label>
                            <input asp-for="DeviceType" class="form-control" placeholder="e.g. Smartphone, Laptop" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Brand" class="form-label fw-semibold"></label>
                            <input asp-for="Brand" class="form-control" placeholder="e.g. Apple, Samsung" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DeviceModel" class="form-label fw-semibold"></label>
                            <input asp-for="DeviceModel" class="form-control" placeholder="e.g. iPhone 15, Galaxy S24" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SerialNumber" class="form-label fw-semibold"></label>
                            <input asp-for="SerialNumber" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label asp-for="ProblemDescription" class="form-label fw-semibold"></label>
                            <textarea asp-for="ProblemDescription" class="form-control" rows="3"
                                      placeholder="Describe the issue..."></textarea>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="IntakeDate" class="form-label fw-semibold"></label>
                            <input asp-for="IntakeDate" class="form-control" type="date" />
                            <span asp-validation-for="IntakeDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="EstimatedReturnDate" class="form-label fw-semibold"></label>
                            <input asp-for="EstimatedReturnDate" class="form-control" type="date" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="EstimatedCost" class="form-label fw-semibold"></label>
                            <input asp-for="EstimatedCost" class="form-control" type="number" step="0.01" min="0" />
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">Save</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
