@model TechClinic.MVC.Features.Technician.SaveTechnicianViewModel
@{
    ViewData["Title"] = Model.IsEdit ? "Edit Technician" : "Add Technician";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-semibold">@ViewData["Title"]</h6>
            </div>
            <div class="card-body">
                <form asp-action="@(Model.IsEdit ? "Edit" : "Create")" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="Id" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="UserName" class="form-label fw-semibold"></label>
                        @if (Model.IsEdit)
                        {
                            <input asp-for="UserName" class="form-control bg-light" readonly />
                        }
                        else
                        {
                            <input asp-for="UserName" class="form-control" />
                        }
                        <span asp-validation-for="UserName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold">
                            @(Model.IsEdit ? "New Password (leave blank to keep)" : "Password")
                        </label>
                        <input asp-for="Password" class="form-control" type="password" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" type="email" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PhoneNo" class="form-label fw-semibold"></label>
                        <input asp-for="PhoneNo" class="form-control" />
                    </div>

                    <div class="mb-4">
                        <label asp-for="Skill" class="form-label fw-semibold"></label>
                        <input asp-for="Skill" class="form-control" placeholder="e.g. iOS Repair, Android, Laptops" />
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Save</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
