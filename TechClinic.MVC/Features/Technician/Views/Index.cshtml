@model List<TechClinic.MVC.Features.Technician.TechnicianListViewModel>
@{
    ViewData["Title"] = "Technician Management";
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h6 class="mb-0 fw-semibold">Technicians</h6>
        <a asp-action="Create" class="btn btn-primary btn-sm">+ Add Technician</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Code</th>
                        <th>Full Name</th>
                        <th>Username</th>
                        <th>Phone</th>
                        <th>Skill</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model)
                    {
                        <tr>
                            <td class="text-muted small">@t.TechnicianCode</td>
                            <td>@t.FullName</td>
                            <td>@t.UserName</td>
                            <td>@(t.PhoneNo ?? "-")</td>
                            <td>@(t.Skill ?? "-")</td>
                            <td>
                                @if (t.Status == "Active")
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-outline-secondary btn-sm">Edit</a>
                                <form asp-action="ToggleStatus" asp-route-id="@t.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm @(t.Status == "Active" ? "btn-outline-warning" : "btn-outline-success")">
                                        @(t.Status == "Active" ? "Deactivate" : "Activate")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">No technicians found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
