@model TechClinic.MVC.Features.SparePart.UpdateStockViewModel
@{
    ViewData["Title"] = "Update Stock";
}

<div class="row justify-content-center">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-semibold">Update Stock</h6>
                <small class="text-muted">@Model.PartName</small>
            </div>
            <div class="card-body">
                <form asp-action="UpdateStock" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="Id" type="hidden" />
                    <input asp-for="PartName" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>

                    <div class="mb-4">
                        <label asp-for="Quantity" class="form-label fw-semibold">New Quantity</label>
                        <input asp-for="Quantity" class="form-control" type="number" min="0" />
                        <span asp-validation-for="Quantity" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Update</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
