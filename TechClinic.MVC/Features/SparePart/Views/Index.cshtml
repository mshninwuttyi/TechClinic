@model List<TechClinic.MVC.Features.SparePart.SparePartListViewModel>
@{
    ViewData["Title"] = "Spare Parts";
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h6 class="mb-0 fw-semibold">Spare Parts (@Model.Count)</h6>
        <a asp-action="Create" class="btn btn-primary btn-sm">+ Add Part</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Part Code</th>
                        <th>Part Name</th>
                        <th>Quantity</th>
                        <th>Unit Price</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td class="text-muted small">@s.PartCode</td>
                            <td>@s.PartName</td>
                            <td>
                                @if (s.Quantity == 0)
                                {
                                    <span class="badge bg-danger">Out of Stock</span>
                                }
                                else if (s.Quantity <= 5)
                                {
                                    <span class="badge bg-warning text-dark">@s.Quantity (Low)</span>
                                }
                                else
                                {
                                    <span>@s.Quantity</span>
                                }
                            </td>
                            <td>@(s.UnitPrice.HasValue ? s.UnitPrice.Value.ToString("N2") : "-")</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-outline-secondary btn-sm">Edit</a>
                                <a asp-action="UpdateStock" asp-route-id="@s.Id" class="btn btn-outline-primary btn-sm">Stock</a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted py-4">No spare parts found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
